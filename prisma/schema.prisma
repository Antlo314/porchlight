// Porchlight data model — PostgreSQL (Neon) in both development and production.
//
// Prisma pins the provider at schema level, so dev and prod share one database
// engine deliberately: the SQLite/Postgres split had already produced one real
// bug. SQLite serializes every write, which silently hid a double-spend in the
// credit ledger that Postgres READ COMMITTED would have allowed
// (see the row lock in src/lib/credits.ts, and scripts/stress/race-credits.ts).
// Matching engines means a race that passes locally actually means something.
//
// Enum-like fields are Strings validated by Zod in src/lib/validators.ts, and
// `images`/`payload` are JSON strings — both carried over from the SQLite
// schema and still fine on Postgres. Keep the value comments in sync.
//
// Local dev: point DATABASE_URL at a Neon *branch* of the same project, so
// local and production schemas can never drift. See docs/DEPLOY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the app; serverless functions open many short-lived
  // connections and would exhaust a direct one.
  url       = env("DATABASE_URL")
  // Migrations need a real session, which the pooler can't give them.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & community
// ─────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  bio            String?
  role           String   @default("MEMBER") // MEMBER | MODERATOR | ADMIN
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  addressLine    String? // used only for residency verification, never public
  verifiedAt     DateTime? // neighborhood residency verified
  karma          Int      @default(0) // earned via helpful posts, completed trades
  inviteCode     String?  @unique // 8-char share code, generated lazily on first use
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts            Post[]
  comments         Comment[]
  reactions        Reaction[]
  sentMessages     Message[]
  conversations    ConversationParticipant[]
  barterListings   BarterListing[]
  barterOffersMade BarterOffer[] @relation("OffersMade")
  creditEntries    TradeCreditEntry[]
  businesses       Business[]
  reviews          Review[]
  notifications    Notification[]
  reportsFiled     Report[]
  follows          NeighborhoodFollow[]
  eventRsvps       EventRsvp[]
  boostEvents      BoostEvent[]
  jobRequests      JobRequest[]
  wants            Want[]
  gameRuns         GameRun[]
  passwordResets   PasswordResetToken[]
  stormCheckIns    StormCheckIn[]
  gamePresence     GamePresence?
}

model Neighborhood {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  city      String
  county    String
  state     String  @default("GA")
  lat       Float
  lng       Float
  stormActive      Boolean   @default(false)
  stormActivatedAt DateTime?
  createdAt DateTime @default(now())

  users          User[]
  posts          Post[]
  barterListings BarterListing[]
  businesses     Business[]
  followers      NeighborhoodFollow[]
  jobRequests    JobRequest[]
  wants          Want[]
  stormCheckIns  StormCheckIn[]
}

// Members see their home neighborhood plus any they follow (nearby areas).
model NeighborhoodFollow {
  userId         String
  neighborhoodId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([userId, neighborhoodId])
}

// ─────────────────────────────────────────────────────────────
// Feed: posts, comments, reactions, events
// ─────────────────────────────────────────────────────────────

model Post {
  id             String   @id @default(cuid())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  type           String   @default("GENERAL") // GENERAL | SAFETY | EVENT | RECOMMENDATION | LOST_FOUND | FREE_STUFF
  title          String?
  body           String
  images         String   @default("[]") // JSON array of URLs
  pinned         Boolean  @default(false)
  expiresAt      DateTime? // SAFETY notices fall off after 14 days
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments  Comment[]
  reactions Reaction[]
  event     EventDetail?
  safety    SafetyDetail?

  @@index([neighborhoodId, createdAt])
}

model EventDetail {
  postId    String   @id
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime?
  location  String
  rsvps     EventRsvp[]
}

// Calm Safety — incident facts only. Never a person description.
model SafetyDetail {
  postId     String   @id
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  location   String
  happenedAt DateTime?
  about      String   @default("INCIDENT") // INCIDENT only
  expiresAt  DateTime
}

// Storm Mode roster — one row per neighbor per neighborhood for the live storm.
model StormCheckIn {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  status         String   // SAFE | NEED_HELP
  resource       String?  // POWER | GENERATOR | CHAINSAW | ROOM | FREEZER | OTHER
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, neighborhoodId])
  @@index([neighborhoodId, status])
}

model EventRsvp {
  eventId   String
  userId    String
  event     EventDetail @relation(fields: [eventId], references: [postId], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String      @default("GOING") // GOING | MAYBE
  createdAt DateTime    @default(now())

  @@id([eventId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?  // one level of threading
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Reaction {
  userId    String
  postId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      String @default("LIKE") // LIKE | THANKS | HELPFUL
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

// ─────────────────────────────────────────────────────────────
// Messaging: DMs and group chats
// ─────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  title     String?  // group chats only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // bumped on new message, used for inbox sort

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  imageUrl       String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Barter: listings, offers, and the trade-credit ledger
// ─────────────────────────────────────────────────────────────

// A barter listing offers GOODS (a physical item), a SERVICE (a skill),
// or TIME (hour-denominated help — the time-banking differentiator).
model BarterListing {
  id             String   @id @default(cuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  kind           String   // GOODS | SERVICE | TIME
  title          String
  description    String
  category       String   // TOOLS | FURNITURE | ELECTRONICS | CLOTHING | GARDEN | SKILLS | CHILDCARE | TUTORING | REPAIRS | OTHER
  images         String   @default("[]") // JSON array of URLs
  wants          String?  // freeform: what the owner wants in return
  creditValue    Int?     // optional asking price in Porch Credits
  status         String   @default("OPEN") // OPEN | PENDING | COMPLETED | WITHDRAWN
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  offers BarterOffer[]

  @@index([neighborhoodId, status, createdAt])
}

model BarterOffer {
  id              String  @id @default(cuid())
  listingId       String
  listing         BarterListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offererId       String
  offerer         User    @relation("OffersMade", fields: [offererId], references: [id], onDelete: Cascade)
  message         String
  offeredItemDesc String? // what they're offering in trade
  creditAmount    Int?    // or an offer in Porch Credits
  status          String  @default("PENDING") // PENDING | ACCEPTED | DECLINED | COMPLETED | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creditEntries TradeCreditEntry[]
}

// Append-only ledger. A user's Porch Credit balance = SUM(delta) of their rows.
// Credits are earned by completing trades/help, spent on barter offers, and can
// be granted (signup bonus, community rewards). Never delete rows.
model TradeCreditEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int      // positive = earned, negative = spent
  reason    String   // SIGNUP_BONUS | TRADE_EARNED | TRADE_SPENT | COMMUNITY_REWARD | INVITE_BONUS | GAME_REWARD | ADJUSTMENT
  offerId   String?
  offer     BarterOffer? @relation(fields: [offerId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  // One settlement per offer, enforced by the database rather than by a code
  // path that could be refactored away. The row lock in settleCreditTrade
  // stops two concurrent settlements overdrawing, but nothing stopped the SAME
  // offer being settled twice — a double-tapped "mark complete", or a retry
  // after a timeout — which would move the credits again and mint a second
  // pair of ledger rows. Postgres treats NULLs as distinct, so the many rows
  // with no offerId (signup and invite bonuses) are unaffected.
  @@unique([offerId, reason])
}

// The other half of barter, and the half every marketplace forgets.
//
// A listing says "here is what I have." A Want says "here is what I need."
// Without both sides recorded, a trade only happens when two people
// coincidentally browse at the right moment and each happens to have what the
// other lacks — the double coincidence of wants, which is exactly why barter
// economies historically collapse into currency.
//
// Recording wants lets the app do the matching instead of leaving it to luck:
// a new listing can find the neighbors already waiting for it, and a new want
// can find listings that already exist. See src/lib/matching.ts.
model Want {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  title          String
  description    String?
  kind           String   // GOODS | SERVICE | TIME — what they're looking for
  category       String   // BarterCategory values (validators.ts)
  creditOffer    Int?     // what they'd pay in Porch Credits
  status         String   @default("OPEN") // OPEN | FULFILLED | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([neighborhoodId, status, createdAt])
}

// Single-use reset links. Raw token never lands in the database — only sha256.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ipHash    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Games — Light the Block and future porch games
// ─────────────────────────────────────────────────────────────

// One row per attempt. Credits are NEVER taken from the client: the server
// recomputes the score from the event log, then grantGameReward() decides
// the drip. Guest runs have no userId and stay DEMO.
model GameRun {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           String    // LIGHT_THE_BLOCK
  nonce          String    @unique
  levelId        String
  seed           String
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  durationMs     Int?
  score          Int?
  porchesLit     Int?
  coins          Int?
  deaths         Int?
  finished       Boolean   @default(false)
  creditsAwarded Int       @default(0)
  status         String    // STARTED | AWARDED | REJECTED | DEMO
  rejectReason   String?
  clientMeta     String?   // JSON, diagnostics only — never trusted for payout

  @@index([userId, startedAt])
  @@index([status, startedAt])
}

// Who is on a block right now. Heartbeat only — never used for credits.
model GamePresence {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKey       String?  @unique
  neighborhoodId String?
  name           String
  course         String
  status         String   // lobby | running | done
  score          Int      @default(0)
  heartbeatAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([neighborhoodId, heartbeatAt])
  @@index([heartbeatAt])
}

// ─────────────────────────────────────────────────────────────
// Businesses & monetization
// ─────────────────────────────────────────────────────────────

model Business {
  id             String   @id @default(cuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  name           String
  category       String   // HOME_SERVICES | FOOD | HEALTH | AUTO | PETS | CLEANING | LANDSCAPING | TUTORING | EVENTS | OTHER
  description    String
  phone          String?
  website        String?
  logoUrl        String?
  verifiedAt     DateTime? // proof-of-service verified by Porchlight
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  services     ServiceListing[]
  subscription Subscription?
  reviews      Review[]
  adBoosts     AdBoost[]
  jobReplies   JobReply[]
}

model ServiceListing {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String
  priceInfo       String?  // freeform: "from $80", "free estimates"
  acceptsCredits  Boolean  @default(false)
  images          String   @default("[]")
  status      String   @default("ACTIVE") // ACTIVE | PAUSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Plans (see docs/HANDOFF.md for pricing rationale):
//   FREE       — business profile + reviews, 1 service listing
//   LOCAL_PRO  — $19/mo: unlimited listings, respond to recommendations
//   FEATURED   — $39/mo: LOCAL_PRO + rotating featured placement + ad-boost pool
model Subscription {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                 String   @default("FREE") // FREE | LOCAL_PRO | FEATURED
  status               String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// The "we pay for your ads" promise: a share of subscription revenue funds
// boosts for verified businesses with strong reviews. poolFunded=true rows are
// paid for by Porchlight, not the business.
model AdBoost {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  poolFunded  Boolean  @default(false)
  startsAt    DateTime
  endsAt      DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  events BoostEvent[]

  @@index([endsAt])
}

// One row per (viewer, boost, kind, day). The unique constraint is what makes
// ad metrics trustworthy: a replayed or scripted call collides instead of
// inflating the counter, and owners can't count their own impressions. The
// Int totals on AdBoost stay as fast denormalized reads, incremented only when
// the event row is genuinely new.
model BoostEvent {
  id        String   @id @default(cuid())
  boostId   String
  boost     AdBoost  @relation(fields: [boostId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // IMPRESSION | CLICK
  day       String   // YYYY-MM-DD — one viewer counts once per boost per day
  createdAt DateTime @default(now())

  @@unique([boostId, userId, kind, day])
}

model Review {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating      Int      // 1–5
  body        String
  verifiedJob Boolean  @default(false) // reviewer completed a paid job with this business
  createdAt   DateTime @default(now())

  @@unique([businessId, authorId])
}

// ─────────────────────────────────────────────────────────────
// Job requests — the reverse marketplace
// ─────────────────────────────────────────────────────────────

// A neighbor posts what they need done; local pros reply FREE. Businesses pay
// for standing presence (Subscription), never for the right to answer a
// neighbor who asked. That asymmetry is deliberate — see docs/STRATEGY.md.
model JobRequest {
  id             String   @id @default(cuid())
  requesterId    String
  requester      User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  neighborhoodId String
  neighborhood   Neighborhood @relation(fields: [neighborhoodId], references: [id])
  title          String
  description    String
  category       String   // BusinessCategory values (validators.ts)
  budgetInfo     String?  // freeform: "under $200", "quote me"
  images         String   @default("[]") // JSON array of URLs
  status         String   @default("OPEN") // OPEN | FULFILLED | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  replies JobReply[]

  @@index([neighborhoodId, status, createdAt])
}

model JobReply {
  id         String   @id @default(cuid())
  jobId      String
  job        JobRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  message    String
  quoteInfo  String?  // freeform: "$150 flat", "free estimate"
  createdAt  DateTime @default(now())

  @@unique([jobId, businessId]) // one reply per business per job
}

// ─────────────────────────────────────────────────────────────
// Notifications & moderation
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // NEW_COMMENT | NEW_MESSAGE | OFFER_RECEIVED | OFFER_ACCEPTED | OFFER_DECLINED | RSVP | REVIEW | JOB_REQUEST | JOB_REPLY | WANT_MATCHED | SYSTEM
  payload   String   @default("{}") // JSON: ids/links needed to render + navigate
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String   // POST | COMMENT | MESSAGE | LISTING | BUSINESS | USER
  targetId   String
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())
}
