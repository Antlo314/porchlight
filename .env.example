# Copy to .env and fill in. Never commit .env.

# ── Required ──────────────────────────────────────────────────
# Neon Postgres. Use the POOLED connection string (it contains "-pooler")
# for the app — serverless functions open many short-lived connections and
# will exhaust a direct connection otherwise.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/porchlight?sslmode=require"

# Direct (non-pooled) connection, used only by `prisma migrate`. Migrations
# need a real session, which the pooler doesn't provide.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/porchlight?sslmode=require"

# Signs session cookies. Generate a fresh one — NEVER reuse the dev value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ── Required in production ────────────────────────────────────
# Your real origin, no trailing slash. Invite links and social share images
# are built from this, so getting it wrong sends neighbors to localhost.
NEXT_PUBLIC_APP_URL="https://porchlight.app"

# Vercel Blob store token. When set, uploads go to Blob; when absent, they
# fall back to local disk so development needs no setup.
BLOB_READ_WRITE_TOKEN=""

# ── Optional (billing is not wired up yet) ────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
