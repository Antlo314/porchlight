{
  "name": "porchlight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "// build": "prisma generate is required: Vercel caches node_modules between builds, so @prisma/client is never regenerated and the build ships a stale client",
    "build": "prisma generate && tsx scripts/apply-live-schema.ts && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "test:game": "tsx scripts/test-game-scoring.ts",
    "assets:game": "node scripts/prepare-game-assets.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.2",
    "jose": "^5.9.6",
    "next": "^15.3.0",
    "phaser": "^3.88.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.5.0",
    "three": "^0.185.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
